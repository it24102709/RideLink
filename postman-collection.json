            "url": {
              "raw": "{{baseUrl}}/api/drivers/user/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "drivers", "user", "{{userId}}"],
              "variable": [
                {
                  "key": "userId",
                  "value": "507f1f77bcf86cd799439011",
                  "description": "User ID"
                }
              ]
            },
            "description": "Retrieve driver profile by user ID"
