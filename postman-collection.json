              "variable": [
                {
                  "key": "driverId",
                  "value": "driver123",
                  "description": "Driver ID"
                }
              ]
            },
            "description": "Update driver availability status"
          },
          "response": []
        },
        {
          "name": "Update Location",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}",
