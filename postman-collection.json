{
  "info": {
    "name": "RideLink - Driver & Vehicle Service",
    "description": "Postman collection for Driver & Vehicle Service API endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3002",
      "type": "string"
    },
    {
      "key": "jwtToken",
      "value": "",
      "type": "string",
      "description": "JWT token for authentication"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Generate JWT Token (Admin)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/token",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "token"]
            },
            "description": "Generate JWT token for admin user (Note: This endpoint should be implemented in Account Service)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Driver Endpoints",
      "item": [
        {
          "name": "Create Driver Profile",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"507f1f77bcf86cd799439011\",\n  \"licenseNumber\": \"DL12345\",\n  \"licenseExpiryDate\": \"2026-12-31T00:00:00\",\n  \"serviceArea\": \"Colombo\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/drivers/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "drivers", "profile"]
            },
            "description": "Create a new driver profile"
          },
          "response": []
        },
        {
          "name": "Get Driver by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/drivers/profile/{{driverId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "drivers", "profile", "{{driverId}}"],
              "variable": [
                {
                  "key": "driverId",
                  "value": "driver123",
                  "description": "Driver ID"
                }
              ]
            },
            "description": "Retrieve driver profile by ID"
          },
          "response": []
        },
        {
          "name": "Get Driver by User ID",
          "request": {
            "method": "GET",
