            "body": {
              "mode": "raw",
              "raw": "{\n  \"coordinates\": [79.8657, 6.9271],\n  \"locationName\": \"Colombo City Center\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/drivers/location/{{driverId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "drivers", "location", "{{driverId}}"],
              "variable": [
                {
                  "key": "driverId",
                  "value": "driver123",
                  "description": "Driver ID"
                }
              ]
            },
            "description": "Update driver current location"
