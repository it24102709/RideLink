          "response": []
        },
        {
          "name": "Get Available Drivers",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[79.8657, 6.9271]"
            },
            "url": {
              "raw": "{{baseUrl}}/api/drivers/available?serviceArea=Colombo&maxDistance=5000",
              "host": ["{{baseUrl}}"],
              "path": ["api", "drivers", "available"],
              "query": [
                {
                  "key": "serviceArea",
                  "value": "Colombo",
                  "description": "Service area"
                },
                {
                  "key": "maxDistance",
                  "value": "5000",
                  "description": "Maximum distance in meters"
                }
              ]
            },
            "description": "Retrieve available drivers in service area"
          },
          "response": []
        },
        {
          "name": "Update Driver Rating",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/drivers/rating/{{driverId}}?rating=4.5",
              "host": ["{{baseUrl}}"],
              "path": ["api", "drivers", "rating", "{{driverId}}"],
              "query": [
                {
                  "key": "rating",
                  "value": "4.5",
                  "description": "Rating (1-5)"
                }
              ],
              "variable": [
                {
                  "key": "driverId",
                  "value": "driver123",
                  "description": "Driver ID"
                }
              ]
            },
            "description": "Update driver rating after ride completion"
          },
          "response": []
        }
